# Cloud saves (optional). Leave empty and the game keeps progress on the device only.
VITE_SUPABASE_URL=
# The publishable (or legacy anon) key. Never the secret / service_role key: the game refuses those.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set to true once the Google provider is configured in Supabase.
VITE_SUPABASE_GOOGLE=false
