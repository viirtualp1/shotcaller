# Cloud saves (optional). Leave empty and the game keeps progress on the device only.
VITE_SUPABASE_URL=
# The publishable (or legacy anon) key. Never the secret / service_role key: the game refuses those.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set to true once the Google provider is configured in Supabase.
VITE_SUPABASE_GOOGLE=false

# Optional PostHog game analytics. Enable after following docs/telemetry.md.
# Project and personal API keys belong in Supabase function secrets, never in VITE_ variables.
# Server variable template: supabase/functions/.env.example.
VITE_TELEMETRY_ENABLED=false

# Discord Activity (optional): the application ID from the Discord Developer Portal. It is public.
VITE_DISCORD_CLIENT_ID=
