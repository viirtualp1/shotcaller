{
  "name": "shotcaller",
  "private": true,
  "version": "9.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "balance": "tsx --tsconfig tsconfig.node.json scripts/balance.ts",
    "balance:ab": "tsx --tsconfig tsconfig.node.json scripts/abTest.ts",
    "balance:items": "tsx --tsconfig tsconfig.node.json scripts/itemBalance.ts",
    "icons": "pwa-assets-generator",
    "patch:discord": "tsx --tsconfig tsconfig.node.json scripts/discordPatch.ts"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@floating-ui/vue": "^2.0.1",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@lucide/vue": "^1.50.0",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vueuse/core": "^15.0.0",
    "check2d": "^9.36.4",
    "driver.js": "^1.8.0",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "gsap": "^3.15.0",
    "lucide-static": "^1.50.0",
    "miniplex": "^2.0.0",
    "mitt": "^3.0.1",
    "neverthrow": "^8.2.0",
    "pinia": "^4.0.3",
    "pixi.js": "^8.22.0",
    "reka-ui": "^2.10.5",
    "seedrandom": "^3.0.5",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.4",
    "@types/seedrandom": "^3.0.8",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "@intlify/unplugin-vue-i18n": {
      "@intlify/vue-i18n-extensions": "^9.0.0"
    },
    "workbox-build": {
      "glob": "^13.0.6"
    },
    "vite-plugin-pwa": {
      "@vite-pwa/assets-generator": "$@vite-pwa/assets-generator"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false,
    "vue-demi": true
  }
}
