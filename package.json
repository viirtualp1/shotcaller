    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "gsap": "^3.15.0",
    "lucide-static": "^1.48.0",
    "lucide-vue-next": "^1.0.0",
    "miniplex": "^2.0.0",
    "mitt": "^3.0.1",
    "neverthrow": "^8.2.0",
    "pinia": "^4.0.3",
