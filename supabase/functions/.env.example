# Server-only secrets for the gameplay telemetry Edge Functions.
# Copy to supabase/functions/.env and fill in the values; that file is ignored by Git.
# Upload to the hosted project with:
# supabase secrets set --env-file supabase/functions/.env --project-ref YOUR_SUPABASE_PROJECT_REF
# YOUR_SUPABASE_PROJECT_REF is the Supabase project ID from its URL:
# https://abcdefghijklmnopqrst.supabase.co -> abcdefghijklmnopqrst.
# It is used in the CLI command only; the POSTHOG_ variables below come from PostHog.

# PostHog Project API key: copy from the US PostHog project's settings.
# This is an event ingestion API key, NOT a Supabase key or project reference.
POSTHOG_PROJECT_KEY=
# PostHog US event ingestion URL.
POSTHOG_HOST=https://us.i.posthog.com

# PostHog numeric Project ID from the same project's settings, NOT the Supabase project reference.
POSTHOG_PROJECT_ID=
# PostHog Personal API key from account settings, with person:write access to that PostHog project.
POSTHOG_PERSONAL_API_KEY=

# Generate a long random token; use the same value in the cleanup scheduler's Bearer header.
TELEMETRY_CLEANUP_TOKEN=
